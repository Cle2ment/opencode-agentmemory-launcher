{
  "name": "opencode-agentmemory-launcher",
  "version": "2.0.0",
  "description": "OpenCode plugin that auto-starts the agentmemory backend with health-check supervision",
  "license": "AGPL-3.0-only",
  "author": "Cle2ment",
  "homepage": "https://github.com/Cle2ment/opencode-agentmemory-launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cle2ment/opencode-agentmemory-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/Cle2ment/opencode-agentmemory-launcher/issues"
  },
  "keywords": [
    "agentmemory",
    "opencode",
    "plugin",
    "launcher",
    "memory",
    "ai-agent"
  ],
  "type": "module",
  "main": "./dist/agentmemory-launcher.js",
  "types": "./dist/agentmemory-launcher.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agentmemory-launcher.d.ts",
      "import": "./dist/agentmemory-launcher.js"
    },
    "./server": {
      "types": "./dist/agentmemory-launcher.d.ts",
      "import": "./dist/agentmemory-launcher.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.17.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
